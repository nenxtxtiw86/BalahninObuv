<Page x:Class="BalahninObuv.LoginPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Авторизация"
      FontFamily="Calibri"
      Background="White">
    <Grid>
        <Border Width="500" Height="380"
                Background="#D2F6E7"
                CornerRadius="15"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">
            <StackPanel Margin="40">
                <TextBlock Text="Авторизация"
                           FontSize="32" FontWeight="Bold"
                           HorizontalAlignment="Center"
                           Foreground="#333333"
                           Margin="0,0,0,30"/>

                <TextBlock Text="Логин:" FontSize="18" Margin="0,0,0,5"/>
                <TextBox Name="TbLogin" Height="40" FontSize="18"
                         Padding="8,0,0,0"/>

                <TextBlock Text="Введите логин пользователя (без пароля)"
                           FontSize="13" Foreground="Gray"
                           Margin="0,5,0,0"/>

                <Button Content="Войти"
                        Height="45" FontSize="18"
                        Margin="0,30,0,0"
                        Background="#70B2AF"
                        Foreground="White"
                        BorderThickness="0"
                        Cursor="Hand"
                        Click="BtnLogin_Click"/>

                <Button Content="Продолжить как гость"
                        Height="40" FontSize="16"
                        Margin="0,15,0,0"
                        Background="Transparent"
                        Foreground="#333333"
                        BorderThickness="0"
                        Cursor="Hand"
                        Click="BtnGuest_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</Page>