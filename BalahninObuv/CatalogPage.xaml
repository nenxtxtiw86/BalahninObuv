<Page x:Class="BalahninObuv.CatalogPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:local="clr-namespace:BalahninObuv"
      mc:Ignorable="d"
      Title="Каталог обуви"
      FontFamily="Calibri"
      Background="White"
      d:DesignHeight="700" d:DesignWidth="1280">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Каталог обуви"
                   FontSize="26" FontWeight="Bold"
                   Foreground="#333333"
                   HorizontalAlignment="Center"
                   Margin="0,15,0,10"/>

        <!-- Панель поиска/фильтра/сортировки -->
        <Border Grid.Row="1" x:Name="FilterPanel" Background="#D2F6E7" Padding="10">
            <WrapPanel HorizontalAlignment="Center">
                <TextBlock Text="Поиск: " FontSize="16" VerticalAlignment="Center"/>
                <TextBox Name="TBox_Search" Width="200" Height="28" FontSize="14"
                         Margin="0,0,15,0" TextChanged="TBox_Search_TextChanged"
                         VerticalContentAlignment="Center"/>

                <TextBlock Text="Категория: " FontSize="16" VerticalAlignment="Center"/>
                <ComboBox Name="ComboCategory" Width="160" Height="28" FontSize="14"
                          Margin="0,0,15,0" SelectionChanged="ComboCategory_SelectionChanged"/>

                <TextBlock Text="Сортировка: " FontSize="16" VerticalAlignment="Center"/>
                <ComboBox Name="ComboSort" Width="220" Height="28" FontSize="14"
                          SelectionChanged="ComboSort_SelectionChanged">
                    <ComboBoxItem>Без сортировки</ComboBoxItem>
                    <ComboBoxItem>Цена по возрастанию</ComboBoxItem>
                    <ComboBoxItem>Цена по убыванию</ComboBoxItem>
                    <ComboBoxItem>Количество выше</ComboBoxItem>
                    <ComboBoxItem>Количество ниже</ComboBoxItem>
                    <ComboBoxItem>Название А-Я</ComboBoxItem>
                    <ComboBoxItem>Название Я-А</ComboBoxItem>
                </ComboBox>
            </WrapPanel>
        </Border>

        <ListView Grid.Row="2" Name="ListViewProducts"
                  BorderThickness="0"
                  ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                  Margin="10" d:ItemsSource="{d:SampleData ItemCount=5}">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                    <Setter Property="Padding" Value="0"/>
                    <Setter Property="Margin" Value="0,0,0,5"/>
                </Style>
            </ListView.ItemContainerStyle>

            <ListView.ItemTemplate>
                <DataTemplate>
                    <Border BorderBrush="#CCCCCC" BorderThickness="1"
                            Background="{Binding RowBackground}" Padding="8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="160"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Width="150" Height="120"
                                    Background="#F5F5F5" BorderBrush="#CCCCCC"
                                    BorderThickness="1">
                                <Image Source="{Binding ImagePath}" Stretch="Uniform" Margin="3"/>
                            </Border>

                            <Grid Grid.Column="1" Margin="15,0,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- Левая часть — вся информация о товаре -->
                                <StackPanel Grid.Column="0">
                                    <TextBlock FontSize="18" FontWeight="Bold" Foreground="#333333">
            <Run Text="{Binding CategoryName, Mode=OneWay}"/>
            <Run Text=" | "/>
            <Run Text="{Binding SubCategoryName, Mode=OneWay}"/>
                                    </TextBlock>

                                    <TextBlock Text="{Binding NameProduct}" FontSize="18"
                   TextWrapping="Wrap" Margin="0,3,0,3"/>

                                    <TextBlock FontSize="15" Margin="0,2,0,0">
            <Run Text="Производитель: "/>
            <Run Text="{Binding ManufactureName, Mode=OneWay}"/>
                                    </TextBlock>

                                    <TextBlock FontSize="15">
            <Run Text="Цена: "/>
            <Run Text="{Binding ProductPrice, StringFormat={}{0:N2} руб., Mode=OneWay}"/>
                                    </TextBlock>

                                    <TextBlock FontSize="15">
            <Run Text="В наличии: "/>
            <Run Text="{Binding TotalInStock, Mode=OneWay}"/>
            <Run Text=" пар"/>
                                    </TextBlock>

                                    <TextBlock FontSize="14" TextWrapping="Wrap" Margin="0,3,0,0">
            <Run Text="Состав: "/>
            <Run Text="{Binding Compound, Mode=OneWay}"/>
                                    </TextBlock>

                                    <TextBlock FontSize="14" TextWrapping="Wrap">
            <Run Text="Размерный ряд: "/>
            <Run Text="{Binding SizeRange, Mode=OneWay}"/>
                                    </TextBlock>

                                    <TextBlock FontSize="14" TextWrapping="Wrap">
            <Run Text="Доступны: "/>
            <Run Text="{Binding AvailableSizes, Mode=OneWay}" FontWeight="Bold" Foreground="#70B2AF"/>
                                    </TextBlock>

                                    <TextBlock Text="{Binding Description}" FontSize="13"
                   Foreground="Gray" TextWrapping="Wrap"
                   Margin="0,5,0,0"/>
                                </StackPanel>

                                <!-- Правая часть — кнопка «Оформить заказ» (только для авторизованных) -->
                                <Button Grid.Column="1"
            Content="Оформить заказ"
            Width="160" Height="45" FontSize="14"
            VerticalAlignment="Center"
            Margin="10,0,0,0"
            Background="#70B2AF" Foreground="White"
            BorderThickness="0" Cursor="Hand"
            Visibility="{Binding BuyVisibility}"
            Click="BtnBuy_Click"/>
                            </Grid>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <TextBlock Grid.Row="3" Name="TbStatus" FontSize="14"
                   Foreground="Gray" HorizontalAlignment="Right"
                   Margin="15,5,15,5"/>
    </Grid>
</Page>