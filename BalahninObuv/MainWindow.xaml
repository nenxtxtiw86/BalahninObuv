<Window x:Class="BalahninObuv.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:BalahninObuv"
        mc:Ignorable="d"
        Title="Чудо Обувь"
        Height="720" Width="1280"
        WindowStartupLocation="CenterScreen"
        Background="#FFFFFF"
        FontFamily="Calibri"
        Icon="/res/Чудо Обувь.ico">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="70"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="35"/>
        </Grid.RowDefinitions>

        <!-- ШАПКА -->
        <Grid Grid.Row="0" Background="#D2F6E7">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Image Grid.Column="0" Source="/res/Чудо Обувь.png"
                   Width="60" Height="60" Margin="15,0,0,0"
                   Stretch="Uniform" VerticalAlignment="Center"/>

            <TextBlock Grid.Column="1" Text="Чудо Обувь"
                       FontSize="28" FontWeight="Bold"
                       Foreground="#333333" VerticalAlignment="Center"
                       Margin="20,0,0,0"/>

            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Name="BtnOrders" Content="Заказы"
            Width="120" Height="35" FontSize="16" Margin="0,0,10,0"
            Background="#70B2AF" Foreground="White" BorderThickness="0"
            Cursor="Hand" Visibility="Collapsed"
            Click="BtnOrders_Click"/>

                <Button Name="BtnAnalytics" Content="Аналитика"
            Width="120" Height="35" FontSize="16" Margin="0,0,10,0"
            Background="#70B2AF" Foreground="White" BorderThickness="0"
            Cursor="Hand" Visibility="Collapsed"
            Click="BtnAnalytics_Click"/>
            </StackPanel>

            <Button Grid.Column="3" Name="BtnBack" Content="Назад"
                    Width="100" Height="35" FontSize="16" Margin="0,0,10,0"
                    Background="#70B2AF" Foreground="White" BorderThickness="0"
                    Cursor="Hand" Visibility="Hidden"
                    Click="BtnBack_Click"/>

            <Button Grid.Column="4" Name="BtnLogout" Content="Выйти"
                    Width="100" Height="35" FontSize="16" Margin="0,0,15,0"
                    Background="#70B2AF" Foreground="White" BorderThickness="0"
                    Cursor="Hand" 
                    Click="BtnLogout_Click"/>
        </Grid>

        <Frame Grid.Row="1" Name="MainFrame"
               Background="White" NavigationUIVisibility="Hidden"/>

        <Border Grid.Row="2" Background="#D2F6E7">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Name="TbCurrentUser"
                           FontSize="14" FontFamily="Calibri"
                           VerticalAlignment="Center" Margin="15,0,0,0"
                           Text="Гость"/>

                <TextBlock Grid.Column="1" FontSize="14" FontFamily="Calibri"
                           VerticalAlignment="Center" Margin="0,0,15,0"
                           Text="Торговая компания «Чудо Обувь»"/>
            </Grid>
        </Border>
    </Grid>
</Window>