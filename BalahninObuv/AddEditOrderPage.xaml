<Page x:Class="BalahninObuv.AddEditOrderPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:local="clr-namespace:BalahninObuv"
      mc:Ignorable="d"
      Title="Заказ"
      FontFamily="Calibri"
      Background="White"
      d:DesignHeight="700" d:DesignWidth="1280">

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Name="TbTitle"
                   Text="Новый заказ"
                   FontSize="26" FontWeight="Bold"
                   Foreground="#333333"
                   HorizontalAlignment="Center"
                   Margin="0,0,0,15"/>

        <Border Grid.Row="1" Background="#D2F6E7" Padding="10" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="Клиент: "
                           FontSize="16" VerticalAlignment="Center"/>
                <ComboBox Grid.Column="1" Name="ComboClient"
                          Height="30" FontSize="14" Margin="0,0,15,0"/>

                <TextBlock Grid.Column="2" Text="Дата: "
                           FontSize="16" VerticalAlignment="Center"/>
                <DatePicker Grid.Column="3" Name="DpDate"
                            Width="180" Height="30" FontSize="14"/>
            </Grid>
        </Border>
        <ListView Grid.Row="2" Name="ListViewItems"
          BorderThickness="1" BorderBrush="#CCCCCC">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="Товар" Width="400"
                            DisplayMemberBinding="{Binding ProductName}"/>
                    <GridViewColumn Header="Размер" Width="80"
                            DisplayMemberBinding="{Binding SizeName}"/>
                    <GridViewColumn Header="Цена" Width="120"
                            DisplayMemberBinding="{Binding Price, StringFormat={}{0:N2}}"/>

                    <!-- Колонка с количеством — с кнопками + и - -->
                    <GridViewColumn Header="Кол-во" Width="140">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <!-- Кнопки +/− видны только админу -->
                                    <Button Content="−" Width="28" Height="24"
                        Background="#70B2AF" Foreground="White"
                        BorderThickness="0" Cursor="Hand"
                        Visibility="{Binding QtyButtonsVisibility}"
                        Click="BtnMinusQty_Click"/>

                                    <TextBlock Text="{Binding Quantity}" Width="40"
                           TextAlignment="Center" VerticalAlignment="Center"
                           FontSize="14"/>

                                    <Button Content="+" Width="28" Height="24"
                        Background="#70B2AF" Foreground="White"
                        BorderThickness="0" Cursor="Hand"
                        Visibility="{Binding QtyButtonsVisibility}"
                        Click="BtnPlusQty_Click"/>
                                </StackPanel>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>

                    <GridViewColumn Header="Сумма" Width="120"
                            DisplayMemberBinding="{Binding Total, StringFormat={}{0:N2}}"/>
                </GridView>
            </ListView.View>
        </ListView>

        <Border Grid.Row="3" Background="#D2F6E7" Padding="10" Margin="0,10,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <TextBlock Name="TbTotal" FontSize="20" FontWeight="Bold"
                           VerticalAlignment="Center" Margin="0,0,20,0"
                           Text="Итого: 0,00 руб."/>

                <Button Name="BtnAddItem" Content="Добавить позицию"
                        Width="180" Height="35" FontSize="14" Margin="0,0,10,0"
                        Background="#70B2AF" Foreground="White"
                        BorderThickness="0" Cursor="Hand"
                        Click="BtnAddItem_Click"/>

                <Button Name="BtnRemoveItem" Content="Удалить позицию"
                        Width="160" Height="35" FontSize="14" Margin="0,0,10,0"
                        Background="#70B2AF" Foreground="White"
                        BorderThickness="0" Cursor="Hand"
                        Click="BtnRemoveItem_Click"/>

                <Button Content="Сохранить" Width="140" Height="35"
                        FontSize="14"
                        Background="#70B2AF" Foreground="White"
                        BorderThickness="0" Cursor="Hand"
                        Click="BtnSave_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</Page>